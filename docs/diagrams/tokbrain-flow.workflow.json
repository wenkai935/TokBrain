{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "TokBrain 内在功能链路（控制面并入后）",
    "subtitle": "两条入口、一个闸门、单 worker 串行；控制面从项目统一入口起停",
    "animation": "trace",
    "quality_profile": "showcase",
    "locale": "zh-CN",
    "views": [
      {
        "id": "happy-path",
        "label": "主链路",
        "focus": [
          "ui",
          "import",
          "preview",
          "confirm",
          "job",
          "pipeline",
          "kb",
          "search"
        ],
        "note": "网页或外部 Agent 发起导入 → 预检 → 确认（只建待入库）→ 入队解析 → 落库 → 检索。"
      },
      {
        "id": "agent-path",
        "label": "外部 Agent 通道",
        "focus": [
          "hermes",
          "mcp",
          "import",
          "confirm",
          "job",
          "search"
        ],
        "note": "Hermes 经 8011 控制 MCP 调同一套 REST，不绕过任何闸门。"
      },
      {
        "id": "failure-path",
        "label": "异常与重试",
        "focus": [
          "job",
          "issues",
          "pipeline"
        ],
        "note": "解析失败进 issues，定向重试或补件后重新入队。"
      },
      {
        "id": "ops-path",
        "label": "运维链路",
        "focus": [
          "hermes",
          "mcp",
          "ops"
        ],
        "note": "控制面并入 TokBrain.cmd 后，启停与审计也在同一条链路上，不再散落在独立脚本。"
      }
    ]
  },
  "lanes": [
    {
      "id": "entry",
      "label": "本机网页"
    },
    {
      "id": "agent",
      "label": "外部 Agent / 运维"
    },
    {
      "id": "api",
      "label": "后端接口 8001"
    },
    {
      "id": "async",
      "label": "队列与协调器"
    },
    {
      "id": "model",
      "label": "抽取与模型"
    },
    {
      "id": "store",
      "label": "知识库"
    }
  ],
  "phases": [
    {
      "id": "intake",
      "label": "入口与导入",
      "fromCol": 0,
      "toCol": 1,
      "variant": "default"
    },
    {
      "id": "gate",
      "label": "预检闸门",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "parse",
      "label": "解析与沉淀",
      "fromCol": 4,
      "toCol": 4,
      "variant": "dashed"
    },
    {
      "id": "consume",
      "label": "检索消费",
      "fromCol": 5,
      "toCol": 5,
      "variant": "default"
    }
  ],
  "groups": [
    {
      "id": "guard",
      "label": "预检 ≠ 入库",
      "lane": "async",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "serial",
      "label": "单 worker 串行",
      "lane": "async",
      "fromCol": 3,
      "toCol": 3,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "ui",
    "import",
    "preview",
    "confirm",
    "job",
    "pipeline",
    "kb",
    "search"
  ],
  "nodes": [
    {
      "id": "ui",
      "lane": "entry",
      "col": 0,
      "type": "frontend",
      "label": "网页四页签",
      "sublabel": "导入 / 解析 / 知识库 / 设置",
      "width": 132
    },
    {
      "id": "hermes",
      "lane": "agent",
      "col": 0,
      "type": "external",
      "label": "Hermes",
      "sublabel": "NAS 上的大肥鱼",
      "tag": "跨机器",
      "width": 132
    },
    {
      "id": "mcp",
      "lane": "agent",
      "col": 1,
      "type": "security",
      "label": "控制 MCP :8011",
      "sublabel": "33 个 tb_* 工具",
      "tag": "Bearer + 审计",
      "width": 140
    },
    {
      "id": "import",
      "lane": "api",
      "col": 1,
      "type": "backend",
      "label": "导入批次",
      "sublabel": "链接 / 本地 / 数据包",
      "tag": "只预检",
      "width": 140
    },
    {
      "id": "preview",
      "lane": "async",
      "col": 2,
      "type": "messagebus",
      "label": "预检协调器 ×3",
      "sublabel": "解析元数据 / 去重 / 配额",
      "width": 140
    },
    {
      "id": "confirm",
      "lane": "api",
      "col": 2,
      "type": "backend",
      "label": "确认入库单",
      "sublabel": "建 pending 作品",
      "tag": "不触发解析",
      "width": 140
    },
    {
      "id": "job",
      "lane": "async",
      "col": 3,
      "type": "messagebus",
      "label": "ingest 任务队列",
      "sublabel": "1 个 worker 轮询",
      "tag": "串行",
      "width": 140
    },
    {
      "id": "issues",
      "lane": "async",
      "col": 4,
      "type": "security",
      "label": "异常池",
      "sublabel": "按 error_code 重试",
      "width": 128
    },
    {
      "id": "pipeline",
      "lane": "model",
      "col": 4,
      "type": "backend",
      "label": "内容管线",
      "sublabel": "下载 / 抽帧 / ASR / OCR",
      "tag": "ASR+OCR+摘要+向量",
      "width": 148
    },
    {
      "id": "kb",
      "lane": "store",
      "col": 5,
      "type": "database",
      "label": "知识库",
      "sublabel": "chunks + 向量 + 摘要",
      "width": 140
    },
    {
      "id": "search",
      "lane": "api",
      "col": 5,
      "type": "backend",
      "label": "检索证据",
      "sublabel": "混合检索 + 词法降级",
      "tag": "只给证据",
      "width": 140
    },
    {
      "id": "ops",
      "lane": "agent",
      "col": 4,
      "type": "security",
      "label": "启停 · 审计",
      "sublabel": "TokBrain.cmd control / tbctl",
      "tag": "身份校验 + JSONL",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "ui-import",
      "from": "ui",
      "to": "import",
      "label": "粘贴链接 / 选文件",
      "variant": "emphasis"
    },
    {
      "id": "hermes-mcp",
      "from": "hermes",
      "to": "mcp",
      "label": "MCP 调用",
      "variant": "security"
    },
    {
      "id": "mcp-import",
      "from": "mcp",
      "to": "import",
      "variant": "emphasis",
      "route": "drop"
    },
    {
      "id": "import-preview",
      "from": "import",
      "to": "preview",
      "label": "入预检队列",
      "variant": "default"
    },
    {
      "id": "preview-confirm",
      "from": "preview",
      "to": "confirm",
      "label": "status=ready",
      "variant": "emphasis"
    },
    {
      "id": "confirm-job",
      "from": "confirm",
      "to": "job",
      "label": "显式入库",
      "variant": "emphasis"
    },
    {
      "id": "job-pipeline",
      "from": "job",
      "to": "pipeline",
      "label": "逐条领取",
      "variant": "emphasis"
    },
    {
      "id": "pipeline-kb",
      "from": "pipeline",
      "to": "kb",
      "label": "写 chunks + 向量",
      "variant": "emphasis"
    },
    {
      "id": "kb-search",
      "from": "kb",
      "to": "search",
      "label": "向量 + 词法",
      "variant": "default",
      "route": "straight"
    },
    {
      "id": "job-issues",
      "from": "job",
      "to": "issues",
      "label": "失败",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "issues-retry",
      "from": "issues",
      "to": "job",
      "label": "定向重试",
      "variant": "dashed",
      "role": "branch",
      "route": "bottom-channel"
    },
    {
      "id": "search-back",
      "from": "search",
      "to": "hermes",
      "label": "证据片段",
      "variant": "dashed",
      "role": "return",
      "width": 1.2
    },
    {
      "id": "mcp-ops",
      "from": "mcp",
      "to": "ops",
      "label": "service_* · 审计",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "主链路只有一条，闸门只有一处",
      "items": [
        "导入不等于入库：预检只解析元数据，不下载、不调模型、不花钱",
        "确认之后作品是 pending，必须再提交 ingest 才会真正解析",
        "两条入口（网页 / 外部 Agent）汇入同一套 REST，没有旁路"
      ]
    },
    {
      "dot": "orange",
      "title": "单 worker 是这条链路的物理约束",
      "items": [
        "ingest 只有 1 个 worker，一次处理一个作品，批量必排队",
        "进度只靠 jobs.progress 轮询，没有 SSE / WebSocket",
        "tb_job_wait 单次最多 90 秒，done=false 要续调，不是失败",
        "取消是安全边界式的：当前作品做完才停"
      ]
    },
    {
      "dot": "cyan",
      "title": "并入统一入口之后",
      "items": [
        "TokBrain.cmd control 与菜单 [8] 直接拉起 8011",
        "tbctl 与控制 MCP 共用同一份实现，命令行能做的 MCP 都能做",
        "启停仍走 stop.ps1 的进程身份校验，写操作全部落审计"
      ]
    },
    {
      "dot": "violet",
      "title": "三条通道各管一段",
      "items": [
        "NAS 快照：离线可用，回答历史收藏，需手动 deploy",
        "8010 只读：本机回环，供本机工具查询",
        "8011 控制：实时可写，Hermes 唯一入口"
      ]
    }
  ]
}