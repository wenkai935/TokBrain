    {
      "dot": "rose",
      "title": "熔断 30 分钟",
      "items": [
        "429 rate_limited、风控 risk_verification、403 access_forbidden 会开熔断",
        "熔断期间新批次直接 429，同批剩余 queued 全部置 blocked",
        "network_timeout / server_error 不熔断，只重试 1 次、间隔 15–30 秒"
      ]
    },
    {
      "dot": "violet",
      "title": "f2 库只做两件事",
      "items": [
        "DouyinCrawler 发请求（带 cookie、显式禁系统代理）",
        "PostDetailFilter 把嵌套 payload 压平成扁平字段",
        "媒体直链来自解析结果，ingest 前还会再刷新一次"
      ]
    }
