  "cards": [
    {
      "dot": "emerald",
      "title": "写路径只有一条",
      "items": [
        "8001 是唯一写库方，控制面与 Agent 都不直接碰 SQLite",
        "8011 只做转发：路由、鉴权、审计，然后调既有 REST",
        "起停走同一套入口：TokBrain.cmd control 或菜单 [8]"
      ]
    },
    {
      "dot": "cyan",
      "title": "只读路径有两条",
      "items": [
        "NAS 快照：PC 关机也能查历史，代价是需要手动 deploy",
        "8010 只读 MCP：本机回环，Hermes 连不上，供本机工具用",
        "两者都标了 readOnlyHint，不会改数据"
      ]
    },
    {
      "dot": "rose",
      "title": "新增暴露面只有 8011",
      "items": [
        "默认关闭：不设 TOKBRAIN_CONTROL_ENABLE=1 直接拒绝启动",
        "非回环必须配 ≥32 位令牌，常量时间比较",
        "防火墙只放行 /24 且限 private 配置；写操作全量审计"
      ]
    },
    {
      "dot": "orange",
      "title": "起停也在同一套入口里",
      "items": [
        "TokBrain.cmd control 或菜单 [8] 拉起 8011",
        "停止仍由 scripts/stop.ps1 按 runtime.json 复核身份",
        "8011 不受主服务 stop 管辖，关它不影响 TokBrain"
      ]
    }
  ]
