# 复制为 mcp.env 后修改（启动MCP服务.cmd 会自动读取本文件）
# 变量名必须与下面保持一致
#
# 注意：本文件只属于 **8010 只读服务**。
# 8011 控制面（有写权限）用另一份配置：mcp_server/control.env.example。
# 两个 .cmd 都是 "for /f 无差别导出整个 env 文件"，混在一起会互相污染。

TOKBRAIN_MCP_PORT=8010
TOKBRAIN_MCP_HOST=127.0.0.1

# 非回环监听必须配置访问令牌，并与客户端的 TOKBRAIN_MCP_TOKEN 完全一致。
# 生成方式（PowerShell）：
#   -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_})
# 回环监听可留空；非回环监听留空时服务会拒绝启动。
TOKBRAIN_MCP_TOKEN=

# 可选：限定允许的 Host 头（逗号分隔）。非回环监听会开启 DNS rebinding 防护，
# 例如本机访问时填 192.168.10.100:8010,127.0.0.1:8010
TOKBRAIN_MCP_ALLOWED_HOSTS=
