# TokBrain 控制 MCP（8011）环境变量模板
#
# 用法：复制成 mcp_server/control.env 再改。
#   copy mcp_server\control.env.example mcp_server\control.env
#
# 注意：本文件与 mcp.env 是**两套**配置，不要混用。
# mcp.env 属于 8010 只读服务；这里属于 8011 控制面（有写权限）。
#
# 生成令牌（32 位十六进制）：
#   .venv-mcp\Scripts\python.exe -c "import secrets;print(secrets.token_hex(16))"
#
# 三个令牌必须互不相同：
#   1) TOKBRAIN_MCP_TOKEN        8010 只读
#   2) TOKBRAIN_CONTROL_TOKEN    8011 控制（本文件）
#   3) data/integration_token.txt 外部导入 v1

# 必须显式设为 1 才会启动。默认关闭，避免装完就暴露到局域网。
TOKBRAIN_CONTROL_ENABLE=1

# 只在本机自测时保持 127.0.0.1；要让 Hermes 连，改成局域网地址（本机实测 192.168.10.100）
TOKBRAIN_CONTROL_HOST=192.168.10.100

# 端口。改了这个，Hermes 侧 config.yaml 的 url 与防火墙规则都要同步改。
TOKBRAIN_CONTROL_PORT=8011

# 非回环监听时必填，至少 32 位。留空只能在 127.0.0.1 上用。
TOKBRAIN_CONTROL_TOKEN=

# 允许的 Host 头（逗号分隔），用于 DNS rebinding 防护。
# 本机 IP 变了就要跟着改；留空时自动取 HOST:PORT。
TOKBRAIN_CONTROL_ALLOWED_HOSTS=192.168.10.100:8011,127.0.0.1:8011

# TokBrain 后端地址。一般不用改。
TOKBRAIN_CONTROL_API_BASE=http://127.0.0.1:8001

# 设为 0 可一键禁掉「永久删除作品 / 停机 / 重启」三个破坏性操作。
TOKBRAIN_CONTROL_ALLOW_DESTRUCTIVE=1

# 数据包导入接口强制同源，控制面会用这个 Origin 头。前端端口是 3001。
TOKBRAIN_CONTROL_ORIGIN=http://127.0.0.1:3001

# ── 媒体路径约定（NAS ⇄ Windows）────────────────────────────────────────
# 大肥鱼在 NAS 上下载视频，控制面在 Windows 上读文件，两边路径不同。
# 这里写明对应关系，之后它传 NAS 路径或 Windows 路径都能正确翻译。
#
# 格式：<Windows 根目录>[|<NAS 前缀>]，多组用分号分隔
# 例：Z:\videos|/vol1/1000/media/videos;D:\本地视频
#
# 配套动作：先双击 mcp_server\挂载NAS媒体盘.cmd 把 NAS 目录映射成 Z:，
# 两边填的 NAS 前缀要和 net use 用的 UNC 对应上。
TOKBRAIN_CONTROL_MEDIA_ROOTS=

# ── 飞书同步桥（可选）──────────────────────────────────────────────────
# 留空时用内置默认表（与 启动飞书同步.cmd、app/services/sync_status.py 一致）。
# 换表必须三处同改，否则控制面拉起来的 bridge 会连到另一张表——
# 表现为"服务在跑但飞书新行纹丝不动"，极难排查。
# FEISHU_BITABLE_APP_TOKEN=WmDJbX7jaaiDvksBX22c7IuLnAf
# FEISHU_BITABLE_TABLE_ID=tblgX5UNFSZu31aj
#
# 同步桥默认走 metadata_only（只抓标题/作者/来源，不下载视频）。
# 要让它真的下载，用 tb_sync_start(download=true) 或 tbctl sync start --download。
#
# ── 预检后是否自动解析 ────────────────────────────────────────────────
# 0（默认）：新链接只做预检（f2 补标题/作者/封面），然后停在「待确认」，
#            等网页勾选或 tb_sync_confirm 放行才入库。手机随手丢链接不该自动烧额度。
# 1：预检完直接确认 + 送入库队列，一路跑到作品出来（旧行为）。
# 想改默认值就把下面这行取消注释。单次覆盖用 tb_sync_start(auto_confirm=true)。
# FS_AUTO_CONFIRM=0
