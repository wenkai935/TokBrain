    "SPEAKER", "notify.xiaomi_cn_936363184_lx06_play_text_a_5_1")
MEDIA = os.getenv("MEDIA", "media_player.xiaomi_cn_936363184_lx06")
# 小爱的「当前音频ID」是独立 sensor（不在播放器属性里）：空 = TTS 播报中，有值 = 歌曲。
# 用来判断播报的起止，进而把播放器恢复成播报前的状态。
AUDIO_ID = os.getenv(
    "AUDIO_ID", "sensor.xiaomi_cn_936363184_lx06_audio_id_p_5_4")

