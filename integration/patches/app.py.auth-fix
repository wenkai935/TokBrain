"""

app = FastAPI(title="life-agent")

# 这些路径本身不含数据，允许匿名访问；/pair 靠 6 位码自己把关。
PUBLIC_PATHS = {"/", "/ui.html", "/manifest.webmanifest", "/icon.svg",
                "/favicon.ico", "/pair"}

_pair_fail = {"n": 0, "until": 0.0}


@app.middleware("http")
async def require_token(request, call_next):
    """本机回环免鉴权；外部须带 X-Token 或有效 Bearer 票据（二选一）。"""
    if API_TOKEN:
        host = request.client.host if request.client else ""
        if host not in ("127.0.0.1", "::1"):
            path = request.url.path
            if path not in PUBLIC_PATHS:
                has_xtoken = request.headers.get("x-token") == API_TOKEN
                # 票据校验是同步 I/O，放进线程池，别阻塞事件循环
                has_ticket = False
                authz = request.headers.get("authorization", "")
                if not has_xtoken and authz:
                    import anyio
                    has_ticket = await anyio.to_thread.run_sync(_ticket_ok, authz)
                if not (has_xtoken or has_ticket):
                    return JSONResponse({"detail": "unauthorized"}, status_code=401)
    return await call_next(request)


