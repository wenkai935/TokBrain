HA_URL = os.getenv("HA_URL", "http://192.168.10.107:8123").rstrip("/")
HA_TOKEN = os.getenv("HA_TOKEN", "")
DB_PATH = os.getenv("DB_PATH", "/data/life.db")
BACKUP_DIR = os.getenv("BACKUP_DIR", os.path.join(os.path.dirname(DB_PATH), "backups"))
BACKUP_KEEP = int(os.getenv("BACKUP_KEEP", "14"))
API_TOKEN = os.getenv("API_TOKEN", "")     # 空 = 不鉴权（仅限纯内网）
PAIR_CODE = os.getenv("PAIR_CODE", "")     # 手机首次配对用的 6 位码
BASE_DIR = os.path.dirname(os.path.abspath(__file__))

# 2026-11-23 统一认证（批次A播报）：外部调用除 X-Token 外，也接受 xiaoqi-auth 短期票据。
# 两者皆无才 401；X-Token 保留 → 现有 life.py / timer 不受影响，可灰度。
XIAOQI_AUTH_URL = os.getenv("XIAOQI_AUTH_URL", "").rstrip("/")
VOICE_AUD = "xiaozhi-gateway"
VOICE_SCOPE = "voice:announce"


def _ticket_ok(authorization: str) -> bool:
    """验 Bearer 票据（aud=xiaozhi-gateway, scope=voice:announce）。失败一律 False。"""
    if not XIAOQI_AUTH_URL or not authorization:
        return False
    parts = authorization.split(None, 1)
    if len(parts) != 2 or parts[0].lower() != "bearer":
        return False
    body = None
    try:
        import json as _json
        import urllib.request as _u
        body = _json.dumps({"token": parts[1], "aud": VOICE_AUD, "scope": VOICE_SCOPE}).encode()
        req = _u.Request(XIAOQI_AUTH_URL + "/verify", data=body,
                         headers={"Content-Type": "application/json"})
        with _u.urlopen(req, timeout=3) as r:
            return bool(_json.loads(r.read().decode("utf-8")).get("valid"))
    except Exception:
        return False

# 文件中转：PC 上传 → 微信网关当附件发出。文件名会被重写成 ASCII 安全名，
# 因为微信网关的附件路径正则不接受中文和空格。
FILE_DROP_DIR = os.getenv("FILE_DROP_DIR", os.path.join(BASE_DIR, "data", "file_drop"))
FILE_DROP_MAX = int(os.getenv("FILE_DROP_MAX", str(50 * 1024 * 1024)))  # 单文件 50MB
FILE_DROP_TTL_H = int(os.getenv("FILE_DROP_TTL_H", "24"))  # 中转文件保留 24h
