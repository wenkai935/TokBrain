@app.get("/rules/morning-weather")
def morning_weather_status():
    path = '/vol1/1000/hermes-state/home-rules.db'
    if not os.path.exists(path):
        return {"configured": False}
    import json
    with closing(sqlite3.connect('file:'+path+'?mode=ro', uri=True)) as c:
        c.row_factory = sqlite3.Row
        connection = c.execute("SELECT value FROM rule_runtime WHERE key='connection'").fetchone()
        days = [dict(r) for r in c.execute('''SELECT date,armed_at,attempted_at,
            delivered_at,state,last_error FROM morning_weather_days ORDER BY date DESC LIMIT 7''')]
    return {"configured": True, "timezone": "Asia/Shanghai", "morning": "06:00–10:00",
            "trigger": "空调关闭后，当天首次实际出冰", "calendar": "中国法定工作日，含调休",
            "connection": json.loads(connection['value']) if connection else None, "days": days}


class MemoryIn(BaseModel):
    key: str
    text: str
    kind: str
    user_quote: str
    expires_at: str | None = None
    valid_from: str | None = None


class MemoryRetractIn(BaseModel):
    key: str
    user_quote: str
    kind: str | None = None


@app.post("/memory/remember")
