    except (ValueError, TypeError) as ex:
        raise HTTPException(400, str(ex))


@app.get("/sysstat")
def sys_stat(days: int = 30):
    """机内温度日峰值与电池状态。这台机器设不了充电阈值，只能盯温度。"""
    latest = sysw.sample() or {}
    return {"latest": latest, "daily": sysw.daily_stats(days),
            "alert_threshold": sysw.threshold}



def tick():
    """每分钟检查一次到期提醒，到点就播报。"""
    due = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with closing(db()) as c:
        rows = c.execute(
            "SELECT * FROM reminders WHERE enabled=1 AND fired_at IS NULL "
            "AND due_at <= ?", (due,)).fetchall()
        for r in rows:
            try:
                speak(r["text"])
                c.execute("UPDATE reminders SET fired_at=? WHERE id=?",
                          (now(), r["id"]))
                c.commit()
            except Exception as ex:
                print(f"提醒 #{r['id']} 播报失败: {ex}")


scheduler = BackgroundScheduler(timezone=os.getenv("TZ", "Asia/Shanghai"))
scheduler.add_job(tick, "interval", minutes=1, id="tick")
scheduler.add_job(_announcements.tick, "interval", seconds=2, id="announcement_queue", max_instances=1, coalesce=True)
scheduler.add_job(backup, "cron", hour=3, minute=30, id="backup")

watcher = HaWatcher(HA_URL, HA_TOKEN, DB_PATH)
scheduler.add_job(watcher.sync, "interval", seconds=30, id="ha_sync",
                  next_run_time=datetime.now() + timedelta(seconds=8))

sysw = SysWatcher(DB_PATH)


def sys_tick():
    """采样温度/电池；过热时提醒一次（每天最多一条）。"""
    s = sysw.sample()
    msg = sysw.check_alert(s)
    if msg:
        try:
            speak(msg)
        except Exception as ex:
            print(f"[sys_watch] 播报失败: {ex}")


scheduler.add_job(sys_tick, "interval", minutes=10, id="sys_tick",
                  next_run_time=datetime.now() + timedelta(seconds=20))
scheduler.start()


