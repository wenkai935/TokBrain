# TokBrain 本地部署配置模板。复制成 .env 再改；.env 不入库。
# 服务默认只监听回环地址，不对外暴露。

APP_HOST=127.0.0.1
APP_PORT=8001
DEBUG=false
# 前端固定跑在 3001（npm run start）；3000 仅 npm run dev 时使用。
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001

# ── 运行期可调限额 ─────────────────────────────────────────────
# 下面这些值只是「初始值」：设置页改过之后，以数据库里持久化的值为准，
# 此文件不再覆盖它们（读取顺序：数据库 > 这里 > 代码默认值）。
#   IMPORT_BATCH_LIMIT  单次导入最多作品数     默认 100（1-1000）
#   IMPORT_DAILY_LIMIT  每日导入上限           默认 150（1-100000）
#   INBOX_BATCH_LIMIT   收件箱单批上限         默认 100（1-1000）
DAILY_MEDIA_MINUTES_LIMIT=60
DAILY_LLM_TOKEN_LIMIT=500000
MONTHLY_WARNING_CNY=50
IMPORT_BATCH_LIMIT=100
IMPORT_DAILY_LIMIT=150
INBOX_BATCH_LIMIT=100

# ── 流水线参数（一般不用动）───────────────────────────────────
SCENE_THRESHOLD=0.40
MAX_SCENE_CANDIDATES=120
MAX_KEYFRAMES=12
MIN_KEYFRAME_GAP_SECONDS=2
OCR_CONCURRENCY=3
KEYFRAME_ANALYSIS_WIDTH=480
MAX_WORK_DURATION_SECONDS=7200
MAX_DOWNLOAD_MEGABYTES=1024
MAX_TEMP_MEGABYTES=2048

# ── 模型供应商 ────────────────────────────────────────────────
# 默认阿里百炼（DashScope 的 OpenAI 兼容端点）。改用其他兼容端点时设
# PROVIDER_TYPE=openai，并填 PROVIDER_BASE_URL / PROVIDER_CHAT_MODEL /
# PROVIDER_EMBEDDING_MODEL；不填则沿用上面的百炼默认模型。
# 注意：API Key 不要写在这里，请到界面里保存（DPAPI 加密存储）。
# PROVIDER_TYPE=openai
# PROVIDER_BASE_URL=https://api.example.com/v1
# PROVIDER_CHAT_MODEL=your-chat-model
# PROVIDER_EMBEDDING_MODEL=your-embedding-model

# ── 外部二进制 ────────────────────────────────────────────────
# ffmpeg / ffprobe 必需（抽帧、转码、ASR 前置）。三种放法任选其一：
#   1. 加入系统 PATH；
#   2. 便携版解压到 <项目>\tools\ffmpeg\bin（推荐，可整包搬机器）；
#   3. 取消下面 FFMPEG_BIN 的注释，指向它的 bin 目录。
# 后端启动时会读这一项并修正 PATH；此外还会自动探测 C:\ffmpeg*\bin、
# D:\code\ffmpeg*\bin 等常见位置。start.ps1 读环境变量与这些目录，
# 找不到只警告，不阻断启动。
# ⚠ 这里必须用正斜杠：.env 按转义解析，D:\tools\ffmpeg\bin 里的 \t \f \b \n
#    会被当成控制字符，路径直接写坏。
# FFMPEG_BIN=D:/tools/ffmpeg/bin
